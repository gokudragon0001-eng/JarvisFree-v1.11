<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="#05070B">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:gravity="center_horizontal" android:padding="22dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="J.A.R.V.I.S" android:textColor="#00D9FF" android:textSize="30sp"
        android:textStyle="bold" android:letterSpacing="0.16" android:layout_marginTop="24dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="PERSONAL AI ASSISTANT" android:textColor="#91A4B7" android:textSize="11sp"
        android:letterSpacing="0.22" android:layout_marginTop="8dp" />
    <View android:layout_width="150dp" android:layout_height="2dp" android:background="#00D9FF"
        android:layout_marginTop="22dp" android:layout_marginBottom="22dp" />
    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="READY • Add free AI key to begin" android:textColor="#B8C7D8" android:textSize="14sp"
        android:gravity="center" android:layout_marginBottom="16dp" />
    <TextView android:id="@+id/heardText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="66dp" android:gravity="center" android:padding="14dp"
        android:text="Your voice or text will appear here" android:textColor="#FFFFFF" android:textSize="17sp"
        android:background="#101923" />
    <Button android:id="@+id/micButton" android:layout_width="150dp" android:layout_height="150dp"
        android:text="🎙\nTAP TO SPEAK" android:textColor="#001018" android:textStyle="bold"
        android:textSize="16sp" android:backgroundTint="#00D9FF" android:layout_marginTop="22dp" />
    <EditText android:id="@+id/promptInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Type a question or command…" android:textColor="#FFFFFF" android:textColorHint="#8193A5"
        android:backgroundTint="#00D9FF" android:padding="12dp"
        android:inputType="textCapSentences|textMultiLine" android:minHeight="54dp" android:layout_marginTop="22dp" />
    <Button android:id="@+id/askButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ASK JARVIS" android:textColor="#001018" android:backgroundTint="#00D9FF" android:layout_marginTop="8dp" />
    <Button android:id="@+id/keyButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="SET UP FREE AI KEY" android:textColor="#00D9FF" android:backgroundTint="#14212C" android:layout_marginTop="8dp" />
    <Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ENABLE OPTIONAL PHONE CONTROL" android:textColor="#00D9FF" android:backgroundTint="#14212C" android:layout_marginTop="8dp" />
    <Button android:id="@+id/remoteButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="REMOTE ACCESS • SETUP STATUS" android:textColor="#00D9FF" android:backgroundTint="#14212C" android:layout_marginTop="8dp" />
    <Button android:id="@+id/wakeButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ENABLE “HELLO” WAKE WORD" android:textColor="#00D9FF" android:backgroundTint="#14212C" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/responseText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="I am ready when you are." android:textColor="#00D9FF" android:textSize="14sp"
        android:gravity="center" android:padding="14dp" android:layout_marginTop="16dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Say “Hello” to wake JARVIS • then say “WhatsApp kholo” or “YouTube kholo”"
        android:textColor="#657789" android:textSize="12sp" android:gravity="center"
        android:layout_marginTop="12dp" android:layout_marginBottom="20dp" />
  </LinearLayout>
</ScrollView>
